# syntax=docker/dockerfile:1
# Community Hub — image WITH the libp2p stack, dependencies installed at BUILD time only.
#   docker build -f Dockerfile.p2p -t community-hub:p2p-test .
# Never run `npm install` inside a running container. P2P stays disabled unless P2P_ENABLED=true is set at runtime.
# The build FAILS (by design) while package-lock.json is empty/stale — generate it with scripts/p2p-lock.sh first.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/p2p-lock-check.js ./scripts/p2p-lock-check.js
# gate 1: lock must be consistent, pinned, https registry only, sha512 integrity on every package
RUN node scripts/p2p-lock-check.js
# gate 2: reproducible install; lifecycle scripts disabled (no native builds, smaller supply-chain surface)
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
# gate 3: the ESM-only packages must be importable on this Node (catches a wrong "exports"/version mix at build time)
RUN node -e "const n=['libp2p','@libp2p/websockets','@libp2p/noise','@libp2p/yamux','@libp2p/identify','@libp2p/ping','@libp2p/peer-id','@libp2p/crypto']; Promise.all(n.map(m=>import(m).then(()=>m))).then(r=>console.log('imports ok:',r.length)).catch(e=>{console.error('IMPORT FAILED',e.message);process.exit(1)})"

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
# runtime stage is identical to the default Dockerfile: non-root, no chmod 777, state in /app/data
COPY --chown=node:node --from=deps /app/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node . .
RUN mkdir -p /app/data && chown -R node:node /app/data
USER node
EXPOSE 8080
VOLUME ["/app/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
